# ===========================================
# SkillDrive 环境变量配置
# ===========================================
# 复制此文件为 .env 并配置实际值
# cp backend/.env.example backend/.env

# ========== 数据库配置 ==========

# SQLite 数据库（默认配置，适合测试/低配机器）
# Docker Compose 默认会覆盖为容器内绝对路径 /app/data/skillhub.db
DATABASE_URL=sqlite+aiosqlite:///./data/skillhub.db

# PostgreSQL 数据库（可选，生产环境推荐）
# 使用 PostgreSQL 时需要修改 docker-compose.yml 添加 db 服务
# DATABASE_URL=postgresql+asyncpg://skillhub:skillhub@db:5432/skillhub
# POSTGRES_USER=skillhub
# POSTGRES_PASSWORD=skillhub
# POSTGRES_DB=skillhub

# ========== 安全配置 ==========

# 安全密钥（必须设置，32字符以上）
# 生产环境请使用随机生成的强密钥
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars

# ========== 调试与日志 ==========

# 调试模式（生产环境设为 false）
DEBUG=false

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志文件路径（空值输出到 stdout/stderr；Docker Compose 默认推荐保持为空）
LOG_FILE=

# ========== CORS 配置 ==========

# 前端代理模式下可使用默认值
# 如需单独访问 API，添加实际域名
CORS_ORIGINS=["http://localhost","http://localhost:3000"]

# ========== Skill 存储 ==========

# Skill 文件存储路径（Docker 容器内路径）
SKILL_STORAGE_PATH=/app/data/skills

# ========== 功能开关 ==========

# 公开注册
ENABLE_PUBLIC_SIGNUP=true

# 邮箱验证码登录
ENABLE_EMAIL_OTP_LOGIN=true

# SSO 登录（需要同时配置 SSO_* 环境变量）
ENABLE_SSO=false

# LDAP 认证（需要同时配置 LDAP_* 环境变量）
ENABLE_LDAP=false

# 组织模型
ENABLE_ORG_MODEL=false

# RBAC 权限控制
ENABLE_RBAC=false

# Skill 可见性控制
ENABLE_SKILL_VISIBILITY=false

# 审计日志
ENABLE_AUDIT_LOG=false

# 审计日志导出
ENABLE_AUDIT_EXPORT=false

# 速率限制
ENABLE_RATE_LIMIT=true

# 指标收集
ENABLE_METRICS=true

# ========== 邮件配置（SMTP） ==========

# 必填项 - 用于发送验证码邮件
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

# ========== S3 存储（可选） ==========
# 如果不使用 S3 存储 skill 包，保持为空

# SKILL_ARCHIVE_BACKEND=local
# SKILL_ARCHIVE_S3_BUCKET=
# SKILL_ARCHIVE_S3_REGION=
# SKILL_ARCHIVE_S3_ENDPOINT=
# SKILL_ARCHIVE_S3_ACCESS_KEY_ID=
# SKILL_ARCHIVE_S3_SECRET_ACCESS_KEY=

# ========== SSO 配置（可选） ==========
# 启用 ENABLE_SSO=true 时需要配置

# 标准 OIDC Authorization Code + PKCE
# SSO_ISSUER=https://sso.example.com
# SSO_CLIENT_ID=skillhub-web
# SSO_CLIENT_SECRET=
# SSO_AUTHORIZATION_ENDPOINT=https://sso.example.com/oauth2/authorize
# SSO_TOKEN_ENDPOINT=https://sso.example.com/oauth2/token
# SSO_JWKS_URI=https://sso.example.com/.well-known/jwks.json
# SSO_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback
# SSO_FRONTEND_CALLBACK_URL=http://localhost:3000/login/sso/callback
# SSO_SCOPES=["openid","email","profile"]


# ========== LDAP 配置（可选） ==========
# 启用 ENABLE_LDAP=true 时需要配置

# LDAP_URL=ldap://your-ldap-server:389
# LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=example,dc=com
# LDAP_SEARCH_BASE=dc=example,dc=com
# LDAP_SEARCH_FILTER=(uid={username})

# ========== 默认值（可选） ==========

# 默认 Skill 可见性：private / team / enterprise
DEFAULT_SKILL_VISIBILITY=private

# 默认角色：admin / member / viewer
DEFAULT_ROLE=member

# 默认用户状态：active / inactive / pending
DEFAULT_USER_STATUS=active

# RBAC 权限配置（JSON 格式）
RBAC_ROLE_PERMISSIONS={"admin":["*"],"member":["dashboard.read","skill.list","skill.read","skill.create","skill.update","skill.delete","skill.upload"],"viewer":["dashboard.read","skill.list","skill.read"]}
