# SkillHub Frontend Environment Configuration

# API Base URL - 后端服务地址
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ========== 功能开关配置 ==========

# 公开注册开关 - true 时显示注册入口
NEXT_PUBLIC_ENABLE_PUBLIC_SIGNUP=true

# 邮箱验证码登录开关 - false 时禁用邮箱验证码登录 (默认开启)
NEXT_PUBLIC_ENABLE_EMAIL_OTP_LOGIN=true

# SSO 登录开关 - true 时显示 SSO 登录入口
NEXT_PUBLIC_ENABLE_SSO=false

# LDAP 登录开关 - true 时显示 LDAP 登录入口
NEXT_PUBLIC_ENABLE_LDAP=false

# 审计日志开关 - false 时隐藏审计日志入口 (默认开启)
NEXT_PUBLIC_ENABLE_AUDIT_LOG=true

# 审计日志导出开关 - false 时禁用导出功能 (默认开启)
NEXT_PUBLIC_ENABLE_AUDIT_EXPORT=true

# 组织模型开关 - true 时启用企业/团队功能
NEXT_PUBLIC_ENABLE_ORG_MODEL=false

# RBAC 权限控制开关 - true 时启用角色权限控制
NEXT_PUBLIC_ENABLE_RBAC=false

# Skill 可见性控制开关 - true 时启用 Skill 可见性设置
NEXT_PUBLIC_ENABLE_SKILL_VISIBILITY=false

# 注意：
# 1. 以 NEXT_PUBLIC_ 开头的变量会在客户端暴露
# 2. 修改此文件后需要重启 Next.js 开发服务器
# 3. 生产环境请使用实际的 API 地址和功能配置
