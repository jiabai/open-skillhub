{
  "name": "skilldrive-desktop",
  "version": "0.1.4",
  "description": "SkillDrive desktop sync client",
  "author": {
    "name": "SkillDrive contributors"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "bin": {
    "skilldrive-agent": "dist-cli/skilldrive-agent.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:electron && vite build && npm run build:electron",
    "build:electron": "vite build --config vite.electron.config.ts && vite build --config vite.preload.config.ts",
    "build:cli": "vite build --config vite.cli.config.ts",
    "preview": "vite preview",
    "start:cli": "node dist-cli/skilldrive-agent.js",
    "start:electron": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:electron": "tsc -p tsconfig.node.json --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux-cli": "npm run build:cli",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "clean": "rimraf dist dist-electron dist-cli"
  },
  "build": {
    "appId": "com.skilldrive.skilldrive-desktop",
    "productName": "SkillDrive Desktop",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/icons/icon.ico",
        "to": "icons/icon.ico"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist/mac/**/*",
      "!dist/*.zip",
      "!dist/*.blockmap",
      "!dist/builder-debug.yml",
      "!dist/builder-effective-config.yaml"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icons/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": true,
      "forceCodeSigning": false,
      "notarize": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "commander": "^12.1.0",
    "extract-zip": "^2.0.1",
    "keytar": "^7.9.0",
    "lucide-react": "^0.452.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.17.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^25.0.1",
    "png2icons": "^2.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  }
}
