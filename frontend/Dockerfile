FROM node:20-alpine AS builder

WORKDIR /app

ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_ENABLE_PUBLIC_SIGNUP
ARG NEXT_PUBLIC_ENABLE_EMAIL_OTP_LOGIN
ARG NEXT_PUBLIC_ENABLE_SSO
ARG NEXT_PUBLIC_ENABLE_LDAP
ARG NEXT_PUBLIC_ENABLE_AUDIT_LOG
ARG NEXT_PUBLIC_ENABLE_AUDIT_EXPORT
ARG NEXT_PUBLIC_ENABLE_ORG_MODEL
ARG NEXT_PUBLIC_ENABLE_RBAC
ARG NEXT_PUBLIC_ENABLE_SKILL_VISIBILITY
ARG API_INTERNAL_URL

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_ENABLE_PUBLIC_SIGNUP=$NEXT_PUBLIC_ENABLE_PUBLIC_SIGNUP
ENV NEXT_PUBLIC_ENABLE_EMAIL_OTP_LOGIN=$NEXT_PUBLIC_ENABLE_EMAIL_OTP_LOGIN
ENV NEXT_PUBLIC_ENABLE_SSO=$NEXT_PUBLIC_ENABLE_SSO
ENV NEXT_PUBLIC_ENABLE_LDAP=$NEXT_PUBLIC_ENABLE_LDAP
ENV NEXT_PUBLIC_ENABLE_AUDIT_LOG=$NEXT_PUBLIC_ENABLE_AUDIT_LOG
ENV NEXT_PUBLIC_ENABLE_AUDIT_EXPORT=$NEXT_PUBLIC_ENABLE_AUDIT_EXPORT
ENV NEXT_PUBLIC_ENABLE_ORG_MODEL=$NEXT_PUBLIC_ENABLE_ORG_MODEL
ENV NEXT_PUBLIC_ENABLE_RBAC=$NEXT_PUBLIC_ENABLE_RBAC
ENV NEXT_PUBLIC_ENABLE_SKILL_VISIBILITY=$NEXT_PUBLIC_ENABLE_SKILL_VISIBILITY
ENV API_INTERNAL_URL=$API_INTERNAL_URL

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV API_INTERNAL_URL=$API_INTERNAL_URL

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
