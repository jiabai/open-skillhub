{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vite.electron.config.ts",
    "vitest.config.ts",
    "electron/**/*.ts",
    "src/i18n/config.ts",
    "src/types/**/*.ts",
    "src/core/**/*.ts",
    "src/adapters/**/*.ts"
  ]
}
