# Copy this file to .env.preprod before starting the test-preprod overlay:
#   cp .env.preprod.example .env.preprod
# Then adjust the values below for your host and browser-facing origin.

# Browser-facing frontend origin used by Next.js at build/runtime.
# Keep http://127.0.0.1:3000 for local-only access.
# Override to your LAN IP or public domain when the browser uses that address.
# Do not use 0.0.0.0 here; it is a bind/listen address, not a browser origin.
# Keep the browser-facing origin local by default.
# Override to your LAN IP or public domain only when the browser actually uses that address.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Internal Docker-network address used by the Next.js server-side rewrite.
API_INTERNAL_URL=http://api:8001

# Match the host user on Linux so bind-mounted ./data and ./logs stay writable.
# Run `id -u` and `id -g` on the host if you need different values.
LOCAL_UID=1000
LOCAL_GID=1000
